<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <let name="diff_params" value="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>

    <arg name="cmd_src" default="teleop" description="Source of control commands. Allowable: circle, teleop, none.">
        <choice value="circle"/>
        <choice value="teleop"/>
        <choice value="none"/>
    </arg>
    <arg name="robot" default="nusim" description="The robotic context. Allowable: nusim, localhost, none.">
        <choice value="nusim"/>
        <choice value="localhost"/>
        <choice value="none"/>
    </arg>
    <arg name="use_rviz" default="true" description="Whether or not to use rviz. Allowable: true, false. MUST BE FALSE WHEN robot:=localhost">
        <choice value="true"/>
        <choice value="false"/>
    </arg>

    <!-- cmd_src argument handling -->
    <node pkg="nuturtle_control" exec="circle" name="circle" if="$(eval '\'$(var cmd_src)\' == \'circle\'')">
        <param name="frequency" value="100"/>
    </node>

    <node if="$(eval '\'$(var cmd_src)\' == \'teleop\'')"
    pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard"
    name="teleop_twist_keyboard" launch-prefix="xterm -e" on_exit="shutdown">
        <env name="TURTLEBOT3_MODEL" value="burger" />
    </node>

    <!-- robot argument handling -->
    <group if="$(eval '\'$(var robot)\' == \'nusim\'')">
        <include file="$(find-pkg-share nusim)/launch/nusim.launch.xml">
            <arg name="diff_params" value="$(var diff_params)"/>
        </include>

        <node pkg="nuturtle_control" exec="odometry">
            <param from="$(var diff_params)"/>
            <param name="wheel_left" value="green/wheel_left_joint"/>
            <param name="wheel_right" value="green/wheel_right_joint"/>
            <param name="body_id" value="green/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <param name="uncorrected_body_id" value="blue/base_footprint"/>
            <param name="uncorrected_odom_id" value="map"/>
            <remap from="joint_states" to="green/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(var diff_params)"/>
            <remap from="wheel_cmd" to="red/wheel_cmd"/>
            <remap from="sensor_data" to="red/sensor_data"/>
            <remap from="joint_states" to="green/joint_states"/>
        </node>

        <!-- slammer owns map->odom; root the map frame to the simulator world -->
        <node pkg="tf2_ros" exec="static_transform_publisher" args="0.0 0 0 0 0 0 nusim/world map"/>
    </group>

    <group if="$(eval '\'$(var robot)\' == \'localhost\'')">

        <node pkg="nuturtle_control" exec="odometry">
            <param from="$(var diff_params)"/>
            <param name="wheel_left" value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>
            <param name="body_id" value="green/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <param name="uncorrected_body_id" value="blue/base_footprint"/>
            <param name="uncorrected_odom_id" value="map"/>
            <remap from="joint_states" to="green/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(var diff_params)"/>
            <remap from="wheel_cmd" to="wheel_cmd"/>
            <remap from="sensor_data" to="sensor_data"/>
            <remap from="joint_states" to="green/joint_states"/>
        </node>

        <node pkg="numsr_turtlebot" exec="numsr_turtlebot" name="numsr_turtlebot"/>
    </group>

    <!-- Slammer node: broadcasts map -> odom -->
    <node pkg="nuslam" exec="slammer" name="slammer">
        <param from="$(var diff_params)"/>
        <param name="obstacle_radius" value="0.038"/>
        <param name="map_id" value="map"/>
        <param name="odom_id" value="odom"/>
        <remap from="fake_input" to="nusim/fake_sensor"/>
        <remap from="odom" to="odom"/>
    </node>

    <!-- use_rviz argument handling -->
    <group if="$(var use_rviz)">

        <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share nuslam)/config/slamFullRviz.rviz" on_exit='shutdown' if="$(eval '\'$(var robot)\' == \'nusim\'')"/>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="use_rviz" value="false"/>
            <arg name="color" value="green"/>
            <arg name="use_jsp" value="false"/>
        </include>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="use_rviz" value="false"/>
            <arg name="color" value="blue"/>
            <arg name="use_jsp" value="true"/>
        </include>

    </group>

</launch>
