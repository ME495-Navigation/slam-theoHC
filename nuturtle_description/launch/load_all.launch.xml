<launch>
    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="purple"/>
    </include>
    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="red"/>
    </include>
    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="green"/>
    </include>
    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="blue"/>
    </include>

    <node pkg="tf2_ros" exec="static_transform_publisher" args="0.25 0 0 0 0 0 1 nusim/world red/base_footprint" />
    <node pkg="tf2_ros" exec="static_transform_publisher" args="0 0.5 0 0 0 0 1 nusim/world green/base_footprint" />
    <node pkg="tf2_ros" exec="static_transform_publisher" args="-0.5 0 0 0 0 0 1 nusim/world blue/base_footprint" />
    <node pkg="tf2_ros" exec="static_transform_publisher" args="0 -1 0 0 0 0 1 nusim/world purple/base_footprint" />

    <node pkg="rviz2" exec="rviz2"  on_exit='shutdown'/>
</launch>

<!-- args="-d $(find-pkg-share nuturtle_description)/config/load-one.rviz" -->