<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="config_file" default="$(find-pkg-share nusim)/config/basic_world.yaml" description="The config file to use for world setup."/>
    <arg name="diff_params" default="$(find-pkg-share nuturtle_description)/config/diff_params.yaml" description="Diff drive params for nusum."/>
    <arg name="standalone" default="false" description="Whether or not to use RVIZ."/>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="red"/>
        <arg name="use_jsp" value="false"/>
    </include>

    <node pkg="nusim" exec="nusimulator">
        <param from="$(var config_file)"/>
        <param from="$(var diff_params)"/>
        <remap from="joint_states" to="red/joint_states"/>
    </node>

    <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share nusim)/config/nusim.rviz" if="$(var standalone)" on_exit='shutdown'/>

</launch>