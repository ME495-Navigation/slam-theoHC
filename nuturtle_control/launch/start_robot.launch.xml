<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- begin_citation [22] -->
    <let name="diff_params" value="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>

    <arg name="cmd_src" default="none" description="Source of control commands. Allowable: circle, teleop, none.">
        <choice value="circle"/>
        <choice value="teleop"/>
        <choice value="none"/>
    </arg>
    <arg name="robot" default="none" description="The robotic context. Allowable: nusim, localhost, none.">
        <choice value="nusim"/>
        <choice value="localhost"/>
        <choice value="none"/>
    </arg>
    <arg name="use_rviz" default="false" description="Whether or not to use rviz. Allowable: true, false. MUST BE FALSE WHEN robot:=localhost">
        <choice value="true"/>
        <choice value="false"/>
    </arg>
    <!-- cmd_source argument handling -->

    <node pkg="nuturtle_control" exec="circle" name="circle" if="$(eval '\'$(var cmd_src)\' == \'circle\'')">
        <param name="frequency" value="100"/>
    </node>

    <node if="$(eval '\'$(var cmd_src)\' == \'teleop\'')"
    pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard"
    name="teleop_twist_keyboard" launch-prefix="xterm -e">
        <env name="TURTLEBOT3_MODEL" value="burger" />
    </node>

    <!-- robot argument handling -->
    <group if="$(eval '\'$(var robot)\' == \'nusim\'')">
        <node pkg="nusim" exec="nusimulator">
            <param from="$(var diff_params)"/>
            <remap from="joint_states" to="red/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="odometry">
            <param from="$(var diff_params)"/>
            <param name="wheel_left" value="red/wheel_left_joint"/>
            <param name="wheel_right" value="red/wheel_right_joint"/>
            <param name="body_id" value="blue/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(var diff_params)"/>
            <remap from="wheel_cmd" to="red/wheel_cmd"/>
            <remap from="sensor_data" to="red/sensor_data"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="tf2_ros" exec="static_transform_publisher" args="0.0 0 0 0 0 0 nusim/world odom"/>
    </group>

    <group if="$(eval '\'$(var robot)\' == \'localhost\'')">

        <node pkg="nuturtle_control" exec="odometry">
            <param from="$(var diff_params)"/>
            <param name="wheel_left" value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>
            <param name="body_id" value="blue/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(var diff_params)"/>
            <remap from="wheel_cmd" to="wheel_cmd"/>
            <remap from="sensor_data" to="sensor_data"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>
    </group>

    <!-- use_viz argument handling -->
    <group if="$(var use_rviz)">

        <node pkg="rviz2" exec="rviz2" on_exit='shutdown'/>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="use_rviz" value="false"/>
            <arg name="color" value="blue"/>
            <arg name="use_jsp" value="false"/>
        </include>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml" if="$(eval '\'$(var robot)\' == \'nusim\'')">
            <arg name="use_rviz" value="false"/>
            <arg name="color" value="red"/>
            <arg name="use_jsp" value="false"/>
        </include>
    </group>

<!-- args="-d $(find-pkg-share nusim)/config/nusim.rviz"  -->
<!-- end_citation [22] -->
</launch>